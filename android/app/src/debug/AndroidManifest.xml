<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets adb start a test skip or a sleep timer in any screen state, e.g.
     adb shell am broadcast -n app.skipify.mobile.debug/app.skipify.mobile.DebugReceiver -a app.skipify.mobile.TEST_SKIP -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!-- debug only: lets adb open the setup screen for testing -->
        <activity
            android:name=".ShizukuSetupActivity"
            android:exported="true"
            tools:replace="android:exported" />
        <activity
            android:name=".HelperSetupActivity"
            android:exported="true"
            tools:replace="android:exported" />
        <receiver
            android:name=".DebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="app.skipify.mobile.TEST_SKIP" />
                <action android:name="app.skipify.mobile.TEST_SLEEP" />
                <action android:name="app.skipify.mobile.TEST_HELPER" />
                <action android:name="app.skipify.mobile.TEST_PAIR" />
                <action android:name="app.skipify.mobile.TEST_PLAY" />
            </intent-filter>
        </receiver>
        <!-- Debug/staging-only probe. Exported so Spotify's documented broadcasts can reach it. -->
        <receiver
            android:name=".SpotifyBroadcastTrace"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.spotify.music.metadatachanged" />
                <action android:name="com.spotify.music.playbackstatechanged" />
                <action android:name="com.spotify.music.queuechanged" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
